NODE_ENV=development
PORT=5050
# On Render this can stay empty: RENDER_EXTERNAL_URL is used.
APP_URL=http://localhost:5050

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=lost_found
DB_USER=lost_found_user
DB_PASSWORD=change_me
# Hosted MySQL (e.g. Aiven) needs TLS: DB_SSL=true and the provider's CA certificate
# (PEM text or base64 of it). Leave both empty for a local MySQL.
DB_SSL=
DB_SSL_CA=

JWT_ACCESS_SECRET=change_me
JWT_REFRESH_SECRET=change_me
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES_DAYS=30

SESSION_SECRET=change_me

ADMIN_EMAIL=admin@lostfound.local
ADMIN_PASSWORD=ChangeMe@123

CORS_ORIGINS=*
SWAGGER_ENABLED=true

# Photo storage: local (saved in ./uploads) or cloudinary (needed on Render — its disk is wiped on restart)
STORAGE_DRIVER=local
UPLOAD_DIR=
CLOUDINARY_FOLDER=lost-found

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Push notifications (optional). Firebase console → Project settings → Service accounts →
# Generate new private key. Use ONE of these. Leave empty to keep push off.
FIREBASE_SERVICE_ACCOUNT_PATH=
FIREBASE_SERVICE_ACCOUNT_JSON=
