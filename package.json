{
  "name": "lost-found-backend",
  "version": "1.0.0",
  "description": "Lost & Found API + admin panel",
  "main": "server.js",
  "scripts": {
    "start": "NODE_ENV=production node server.js",
    "render:start": "sequelize-cli db:migrate && sequelize-cli db:seed:all && node server.js",
    "dev": "nodemon server.js",
    "db:migrate": "sequelize-cli db:migrate",
    "db:migrate:undo": "sequelize-cli db:migrate:undo",
    "db:seed": "sequelize-cli db:seed:all",
    "db:reset": "sequelize-cli db:migrate:undo:all && sequelize-cli db:migrate && sequelize-cli db:seed:all",
    "test:db": "NODE_ENV=test sequelize-cli db:migrate",
    "test": "NODE_ENV=test jest --runInBand",
    "seed:demo": "node scripts/seed-demo.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.2",
    "connect-session-sequelize": "^8.0.6",
    "cors": "^2.8.6",
    "dotenv": "^18.0.7",
    "ejs": "^7.0.1",
    "express": "^5.3.0",
    "express-ejs-layouts": "^2.5.1",
    "express-rate-limit": "^8.7.1",
    "express-session": "^1.19.0",
    "firebase-admin": "^14.5.0",
    "helmet": "^8.3.0",
    "joi": "^18.2.9",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.12.1",
    "multer": "^2.4.0",
    "mysql2": "^3.24.5",
    "sequelize": "^6.37.8",
    "sequelize-cli": "^6.6.5",
    "sharp": "^0.35.5",
    "socket.io": "^4.8.4",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "nodemon": "^3.1.14",
    "socket.io-client": "^4.8.4",
    "supertest": "^7.3.1"
  },
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "jest": {
    "testEnvironment": "node"
  },
  "nodemonConfig": {
    "watch": [
      "src",
      "server.js"
    ],
    "ext": "js,ejs,json"
  }
}
