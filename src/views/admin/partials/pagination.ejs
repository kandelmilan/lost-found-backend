<%
  // Expects: pagination { page, totalPages, total, limit }, baseQuery (current filters/sort), noun ('item')
  const link = (p) => '?' + new URLSearchParams({ ...baseQuery, page: p }).toString();
  const start = Math.max(1, pagination.page - 2);
  const end = Math.min(pagination.totalPages, pagination.page + 2);
  const from = pagination.total ? (pagination.page - 1) * pagination.limit + 1 : 0;
  const to = Math.min(pagination.page * pagination.limit, pagination.total);
%>
<div class="d-flex flex-wrap gap-2 justify-content-between align-items-center">
  <span class="small text-muted">Showing <%= from %>–<%= to %> of <%= pagination.total %> <%= noun %><%= pagination.total === 1 ? '' : 's' %></span>
  <% if (pagination.totalPages > 1) { %>
    <nav aria-label="Pagination">
      <ul class="pagination pagination-sm mb-0">
        <li class="page-item <%= pagination.page === 1 ? 'disabled' : '' %>">
          <a class="page-link" href="<%= link(pagination.page - 1) %>" aria-label="Previous">&laquo;</a>
        </li>
        <% for (let p = start; p <= end; p++) { %>
          <li class="page-item <%= p === pagination.page ? 'active' : '' %>">
            <a class="page-link" href="<%= link(p) %>"><%= p %></a>
          </li>
        <% } %>
        <li class="page-item <%= pagination.page === pagination.totalPages ? 'disabled' : '' %>">
          <a class="page-link" href="<%= link(pagination.page + 1) %>" aria-label="Next">&raquo;</a>
        </li>
      </ul>
    </nav>
  <% } %>
</div>
