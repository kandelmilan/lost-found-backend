<%
  // Expects: action (form URL), placeholder, list ({ q, limit, sort, dir }), exportUrl,
  //          filterFields (optional array of { name, label, options: [[value, label]], current }), activeFilters (count)
  const fields = typeof filterFields !== 'undefined' ? filterFields : [];
%>
<form method="get" action="<%= action %>" class="table-toolbar">
  <input type="hidden" name="sort" value="<%= list.sort %>">
  <input type="hidden" name="dir" value="<%= list.dir %>">

  <div class="input-group search-box">
    <span class="input-group-text"><i class="bi bi-search"></i></span>
    <input type="search" name="q" class="form-control" placeholder="<%= placeholder %>" value="<%= list.q %>" aria-label="Search">
  </div>

  <div class="toolbar-right">
    <label class="rows-label" for="rows-per-page">Rows per page</label>
    <select id="rows-per-page" name="limit" class="form-select rows-select" data-autosubmit>
      <% [10, 20, 50, 100].forEach((n) => { %>
        <option value="<%= n %>" <%= list.limit === n ? 'selected' : '' %>><%= n %></option>
      <% }) %>
    </select>

    <% if (fields.length) { %>
      <div class="dropdown">
        <button type="button" class="btn btn-outline-secondary dropdown-toggle" data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-expanded="false">
          <i class="bi bi-sliders"></i> Filters<% if (activeFilters) { %> <span class="badge text-bg-primary"><%= activeFilters %></span><% } %>
        </button>
        <div class="dropdown-menu dropdown-menu-end p-3 filter-menu shadow-sm">
          <% fields.forEach((f) => { %>
            <div class="mb-2">
              <label class="form-label small mb-1" for="filter-<%= f.name %>"><%= f.label %></label>
              <select id="filter-<%= f.name %>" name="<%= f.name %>" class="form-select form-select-sm">
                <option value="">All</option>
                <% f.options.forEach(([v, l]) => { %>
                  <option value="<%= v %>" <%= String(f.current ?? '') === String(v) ? 'selected' : '' %>><%= l %></option>
                <% }) %>
              </select>
            </div>
          <% }) %>
          <div class="d-flex gap-2 mt-3">
            <button type="submit" class="btn btn-primary btn-sm flex-grow-1">Apply</button>
            <a href="<%= action %>" class="btn btn-light btn-sm">Reset</a>
          </div>
        </div>
      </div>
    <% } %>

    <a href="<%= exportUrl %>" class="btn btn-outline-secondary"><i class="bi bi-file-earmark-arrow-down"></i> Export</a>
    <button type="button" class="btn btn-outline-secondary" data-action="print"><i class="bi bi-printer"></i> Print</button>
  </div>
</form>
