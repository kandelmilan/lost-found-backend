<div class="page-header">
  <h1 class="page-heading">Categories</h1>
</div>

<div class="row g-3">
  <div class="col-12 col-xl-8">
    <div class="card">
      <div class="card-header">
        <div class="card-title-row">
          <h2 class="card-title"><i class="bi bi-tags"></i> Item categories</h2>
          <a href="#add-category" class="btn btn-primary d-xl-none"><i class="bi bi-plus-lg"></i> Add Category</a>
        </div>
      </div>
      <div class="table-responsive">
        <table class="table data-table align-middle">
          <thead>
            <tr>
              <th>Order</th>
              <th>Name</th>
              <th class="d-none d-sm-table-cell">Slug</th>
              <th class="text-end">Items</th>
              <th>Status</th>
              <th class="col-actions">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% if (!rows.length) { %>
              <tr><td colspan="6" class="text-center text-muted py-5">No categories yet.</td></tr>
            <% } %>
            <% rows.forEach(({ category, itemCount }) => { %>
              <tr>
                <td class="code-cell"><%= category.sort_order %></td>
                <td>
                  <div class="fw-semibold"><%= category.name %></div>
                  <% if (category.icon) { %><div class="small text-muted">icon: <%= category.icon %></div><% } %>
                </td>
                <td class="d-none d-sm-table-cell"><code><%= category.slug %></code></td>
                <td class="text-end">
                  <% if (itemCount) { %><a href="/admin/items?category=<%= category.id %>"><%= itemCount %></a><% } else { %>0<% } %>
                </td>
                <td><span class="pill <%= category.is_active ? 'pill-active' : 'pill-inactive' %>"><%= category.is_active ? 'Active' : 'Inactive' %></span></td>
                <td class="col-actions">
                  <div class="d-inline-flex gap-2">
                    <a href="/admin/categories/<%= category.id %>/edit" class="btn-icon" title="Edit" aria-label="Edit <%= category.name %>"><i class="bi bi-pencil"></i></a>
                    <% if (!itemCount) { %>
                      <form method="post" action="/admin/categories/<%= category.id %>/delete" data-confirm="Delete the category &quot;<%= category.name %>&quot;?">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <button type="submit" class="btn-icon danger" title="Delete" aria-label="Delete <%= category.name %>"><i class="bi bi-trash"></i></button>
                      </form>
                    <% } %>
                  </div>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
      <div class="card-footer small text-muted">
        Categories with items can't be deleted — deactivate them instead. Inactive categories are hidden from the app, but existing items keep them.
      </div>
    </div>
  </div>

  <div class="col-12 col-xl-4">
    <div class="card" id="add-category">
      <div class="card-header"><h2 class="card-title"><i class="bi bi-plus-circle"></i> Add category</h2></div>
      <div class="card-body p-4">
        <form method="post" action="/admin/categories">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <div class="mb-3">
            <label for="name" class="form-label">Name</label>
            <input type="text" id="name" name="name" class="form-control" required minlength="2" maxlength="60" placeholder="e.g. Umbrella">
          </div>
          <div class="mb-3">
            <label for="icon" class="form-label">Icon <span class="text-muted small">(optional)</span></label>
            <input type="text" id="icon" name="icon" class="form-control" maxlength="60" pattern="[a-z0-9\-]*" placeholder="e.g. umbrella">
            <div class="form-text">Icon name the mobile app maps to a picture.</div>
          </div>
          <div class="mb-4">
            <label for="sort_order" class="form-label">Order</label>
            <input type="number" id="sort_order" name="sort_order" class="form-control" min="0" max="9999" value="<%= rows.length + 1 %>">
          </div>
          <button type="submit" class="btn btn-primary w-100"><i class="bi bi-plus-lg"></i> Add Category</button>
        </form>
      </div>
    </div>
  </div>
</div>
