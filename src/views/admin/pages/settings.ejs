<div class="page-header">
  <h1 class="page-heading">Settings</h1>
</div>

<div class="row g-3">
  <div class="col-12 col-xl-6">
    <div class="card mb-3">
      <div class="card-header"><h2 class="card-title"><i class="bi bi-person-badge"></i> Your account</h2></div>
      <div class="card-body px-4">
        <dl class="row mb-0 detail-list">
          <dt class="col-4">Name</dt><dd class="col-8"><%= admin.name %></dd>
          <dt class="col-4">Email</dt><dd class="col-8"><%= admin.email %></dd>
          <dt class="col-4">Last sign-in</dt><dd class="col-8"><%= formatDate(admin.last_login_at) %></dd>
        </dl>
      </div>
    </div>

    <div class="card">
      <div class="card-header"><h2 class="card-title"><i class="bi bi-key"></i> Change password</h2></div>
      <div class="card-body px-4">
        <% if (error) { %><div class="alert alert-danger py-2" role="alert"><%= error %></div><% } %>
        <form method="post" action="/admin/settings/password" autocomplete="off">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <input type="text" name="username" value="<%= admin.email %>" autocomplete="username" hidden>
          <div class="mb-3">
            <label for="current_password" class="form-label">Current password</label>
            <input type="password" id="current_password" name="current_password" class="form-control" required autocomplete="current-password">
          </div>
          <div class="mb-3">
            <label for="new_password" class="form-label">New password</label>
            <input type="password" id="new_password" name="new_password" class="form-control" required minlength="10" maxlength="72" autocomplete="new-password">
            <div class="form-text">At least 10 characters, with a letter and a number.</div>
          </div>
          <div class="mb-4">
            <label for="confirm_password" class="form-label">Confirm new password</label>
            <input type="password" id="confirm_password" name="confirm_password" class="form-control" required autocomplete="new-password">
          </div>
          <button type="submit" class="btn btn-primary"><i class="bi bi-shield-check"></i> Change password</button>
          <div class="form-text mt-2">You stay signed in here; other devices are signed out.</div>
        </form>
      </div>
    </div>
  </div>
</div>
